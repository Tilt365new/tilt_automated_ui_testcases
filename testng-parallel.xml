<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Parallel"
       verbose="1"
       preserve-order="true"
       parallel="methods"
       thread-count="14"
       time-out="3000000">


<listeners>
        <!-- Your custom listeners -->
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Smoke Tests (Parallel)">
        <groups>
            <run>
                <!--                <include name="test-solo"/>-->
                <!--                <include name="ui-only"/>-->
                <exclude name="known-bug"/>
            </run>
        </groups>
        <classes>
            <class name="tests.Phase1SmokeTests"/>
            <class name="tests.individuals.IndividualsListTests"/>
            <class name="tests.ManualEntryValidationTests"/>
            <class name="tests.TiltSmokeTest"/>
            <class name="tests.purchases.PurchaseFlowTests"/>
            <class name="tests.shop.TtpRecipientSelectionTest"/>
            <class name="tests.SignUpFlowTests.SignUpFlowTest"/>
            <class name="tests.teams.TeamClimateTests"/>
            <class name="tests.teams.TeamAssessmentPurchaseAndAssignment"/>
            <class name="tests.teams.AddTeamMemberFlows"/>
            <class name="tests.OrderPreviewCouponFlowTests"/>
            <class name="tests.OrderPreviewSmokeTests"/>
            <class name="tests.reports.ReportGenerationTests"/>
            <class name="tests.resources.ResourcesPageTests"/>






            <!-- add more classes as needed -->
        </classes>
    </test>
</suite>
